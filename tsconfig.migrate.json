{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "lib/**/*.ts",
    "prisma/**/*.ts"
  ]
}